.venv/
.vscode/
__pycache__/
*.pyc

# HPWH bulk data -- regenerable via HPWH_A1/A2/A3 (per-home ResStock
# datasets) or simulation output (Ready_data/), not primary source data.
# HPWH/Weather/ is intentionally NOT excluded -- it's a single small EPW
# file, worth tracking like code.
HPWH/*Input Files*/
HPWH/Ready_data/
HPWH/Metadata/
HPWH/HPWH Filtered/

# Local last-run state (see HPWH/run_context.py) -- which B3 filename the
# C1/C2/C3 scripts should inherit, not something to share across machines.
HPWH/.last_run_filename

~$FL Reserve Calculator.xlsm
